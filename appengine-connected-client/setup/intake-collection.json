            "Whole home"
          ],
          "description": "Choose the scope so the specialist can prepare."
        },
        "brief": {
          "type": "string",
          "title": "What would you like help with?",
          "minLength": 12,
          "maxLength": 300,
          "x-control-variant": "textarea"
        },
        "contactConsent": {
          "type": "boolean",
          "title": "I agree to be contacted about this booking",
          "const": true
        }
      }
    }
  }
