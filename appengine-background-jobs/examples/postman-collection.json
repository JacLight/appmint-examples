        "url": "{{APPMINT_BASE}}/repository/create",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"datatype\": \"{{MARKER_DATATYPE}}\",\n  \"isNew\": true,\n  \"data\": {\n    \"reference\": \"{{PREFIX}}-release\",\n    \"status\": \"waiting\"\n  }\n}",
