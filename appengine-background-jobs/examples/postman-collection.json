          "raw": "{\n  \"query\": {\n    \"data.relatedTo.id\": \"{{LEAD_ID}}\",\n    \"data.source\": \"lead-sla\"\n  },\n  \"options\": {\n    \"page\": 1,\n    \"pageSize\": 20\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
