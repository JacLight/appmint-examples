          "mode": "raw",
          "raw": "{\n  \"datatype\": \"schedule\",\n  \"isNew\": true,\n  \"data\": {\n    \"name\": \"{{PREFIX}}-release\",\n    \"title\": \"One-time follow-up preparation\",\n    \"type\": \"simple\",\n    \"status\": \"active\",\n    \"target\": [\n      {\n        \"datatype\": \"{{MARKER_DATATYPE}}\",\n        \"id\": \"{{MARKER_ID}}\"\n      }\n    ],\n    \"start\": {\n      \"date\": \"{{FUTURE_1H}}\",\n      \"action\": \"update-status\",\n      \"actionArgs\": \"ready\"\n    }\n  }\n}",
          "options": {
