# Where appengine lives. No trailing slash.
APPENGINE_ENDPOINT=https://appengine.appmint.io

# The organization every request is scoped to.
ORG_ID=your-org-id

# Application credentials. These stay on the server — they are never sent to
# the browser, and the proxy in app/api/[...slug] is what keeps it that way.
APP_ID=your-app-id
APP_KEY=your-app-key
APP_SECRET=your-app-secret
