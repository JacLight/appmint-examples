{
  "method": "POST",
  "path": "/shipping/order/manual",
  "identity": "staff",
  "mutation": true,
  "body": {
    "orderNumber": "YOUR_PAID_ORDER_NUMBER",
    "sendNotification": false,
    "shippingInfo": {
      "carrier": "YOUR_LABEL_CARRIER",
      "tracker": "YOUR_NEW_CORRECT_ADDRESS_TRACKING_NUMBER",
      "trackingUrl": "YOUR_NEW_LABEL_TRACKING_URL",
      "rate": "YOUR_LABEL_SERVICE",
      "cost": "YOUR_ACTUAL_NEW_LABEL_COST",
      "parcel": {
        "length": 16,
        "width": 12,
        "height": 1,
        "weight": 1,
        "weightUnit": "lb",
        "dimensionUnit": "in"
      },
      "products": [
        {
          "sku": "YOUR_ORDER_LINE_SKU",
          "name": "YOUR_ORDER_LINE_NAME",
          "quantity": 2
        }
      ]
    }
  }
}
