          "raw": "{\n  \"name\": \"wf-usecase-1011-warranty\",\n  \"title\": \"Warranty Claim Approval\",\n  \"enabled\": true,\n  \"notificationTemplate\": [],\n  \"stages\": [\n    {\n      \"id\": 0,\n      \"type\": \"start\",\n      \"name\": \"Waiting for approval\",\n      \"modelState\": \"inprogress\",\n      \"modelStatus\": \"new\",\n      \"assignRule\": {\n        \"type\": \"users\",\n        \"users\": [\n          \"priya.wf-usecase-1011@training.local\"\n        ],\n        \"fallbackRoles\": [\n          \"Owner\"\n        ]\n      },\n      \"notificationTemplate\": [],\n      \"escalations\": [\n        {\n          \"escalateAfter\": 2,\n          \"units\": \"days\",\n          \"escalateRule\": {\n            \"type\": \"users\",\n            \"users\": [\n              \"sam.wf-usecase-1011@training.local\"\n            ]\n          },\n          \"notificationTemplate\": []\n        }\n      ]\n    },\n    {\n      \"id\": 1,\n      \"type\": \"done\",\n      \"name\": \"Approved\",\n      \"modelState\": \"completed\",\n      \"modelStatus\": \"approved\",\n      \"notificationTemplate\": []\n    },\n    {\n      \"id\": 2,\n      \"type\": \"done\",\n      \"name\": \"Rejected\",\n      \"modelState\": \"completed\",\n      \"modelStatus\": \"rejected\",\n      \"notificationTemplate\": []\n    }\n  ]\n}",
