# ── AI employee session manager — everything that changes per machine ──
# Copy to .env (never commit .env). `npm start` reads it.

# Where it listens. appengine calls http://<host>:<port> — see AI_EMPLOYEE_SESSION_MANAGER_URL on appengine.
AIE_PORT=3400
# 0.0.0.0 = all interfaces (a server appengine reaches over the network); 127.0.0.1 = same machine only.
AIE_HOST=0.0.0.0

# The bearer key appengine sends on every call. REQUIRED in production (NODE_ENV=production refuses to start without it).
# Must equal AI_EMPLOYEE_SESSION_MANAGER_KEY on appengine. Generate one: openssl rand -hex 32
AIE_PROVIDER_KEY=

# Agents, their sign-ins (password + authenticator secret) and job transcripts.
# On a server: a persistent, backed-up volume that only this service can read.
AIE_DATA_DIR=./data

# How often an idle agent checks its queue (ms).
AIE_POLL_MS=15000

# Model when an employee names none (a Claude Code model alias or id).
AIE_MODEL=sonnet
# Limits on one job's session.
AIE_MAX_TURNS=40
AIE_JOB_TIMEOUT_MIN=20

# The Claude Code CLI each job runs (installed on this machine: npm i -g @anthropic-ai/claude-code).
AIE_CLAUDE_BIN=claude
# How Claude Code signs in — your Claude subscription, not an API key.
# Locally it uses your own login. On a server run `claude setup-token` once (on your machine),
# and put the long-lived token it prints here (as a secret):
CLAUDE_CODE_OAUTH_TOKEN=
# Only if you would rather bill an API key instead of the subscription:
# ANTHROPIC_API_KEY=

NODE_ENV=development
