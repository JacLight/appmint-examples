      "comment": "Hours and configured calculation reviewed"
    }
  },
  {
    "id": "approval-task",
    "actor": "assigned approver",
    "method": "GET",
    "path": "/approval/task/{{TASK_ID}}"
  },
  {
    "id": "workflow-position",
    "actor": "staff",
    "method": "GET",
    "path": "/workflow/position/bm_payroll_run/{{RUN_ID}}"
  },
  {
