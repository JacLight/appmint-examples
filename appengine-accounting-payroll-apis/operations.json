  },
  {
    "id": "run-journals",
    "actor": "staff",
    "method": "POST",
    "path": "/repository/find/journal_entry",
    "body": {
      "query": {
        "data.referenceId": "{{RUN_ID}}"
      },
      "options": {
        "page": 1,
        "pageSize": 100
      }
    }
  },
  {
    "id": "stub-pdf",
    "actor": "staff",
