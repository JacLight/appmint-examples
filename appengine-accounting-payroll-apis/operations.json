      "payPeriodEnd": "{{PERIOD_END}}",
      "payDate": "{{PAY_DATE}}",
      "employeeIds": [
        "{{EMPLOYEE_CODE}}"
      ],
      "businessLocationId": "{{LOCATION_NAME}}",
      "type": "regular"
    }
  },
  {
    "id": "run-create",
    "actor": "staff",
    "method": "POST",
    "path": "/business-made/payroll/runs",
    "body": {
      "payPeriodStart": "{{PERIOD_START}}",
      "payPeriodEnd": "{{PERIOD_END}}",
      "payDate": "{{PAY_DATE}}",
      "employeeIds": [
        "{{EMPLOYEE_CODE}}"
      ],
      "businessLocationId": "{{LOCATION_NAME}}",
      "type": "regular"
    }
  },
  {
    "id": "run-read",
    "actor": "staff",
    "method": "GET",
    "path": "/business-made/payroll/runs/{{RUN_ID}}"
  },
  {
    "id": "run-calculate",
    "actor": "staff",
    "method": "POST",
    "path": "/business-made/payroll/runs/{{RUN_ID}}/calculate",
