    "path": "/business-made/books/ledger/6000?fromDate={{PERIOD_START}}&toDate={{PERIOD_END}}&businessLocationId={{LOCATION_NAME}}"
  },
  {
    "id": "payroll-preview",
    "actor": "staff",
    "method": "POST",
    "path": "/business-made/payroll/run/preview",
    "body": {
