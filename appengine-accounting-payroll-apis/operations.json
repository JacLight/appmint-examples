    "id": "journal-create",
    "actor": "staff",
    "method": "POST",
    "path": "/business-made/books/journals",
    "body": {
      "date": "{{ENTRY_DATE}}",
      "memo": "Training rent journal",
      "businessLocationId": "{{LOCATION_NAME}}",
      "lines": [
        {
          "account": "6000",
          "debit": 1800,
          "credit": 0
        },
        {
          "account": "1000",
          "debit": 0,
          "credit": 1800
        }
      ]
    }
  },
  {
    "id": "journal-read",
    "actor": "staff",
    "method": "GET",
    "path": "/business-made/books/journals/{{JOURNAL_ID}}"
  },
  {
    "id": "journal-post",
    "actor": "staff",
    "method": "POST",
    "path": "/business-made/books/journals/{{JOURNAL_ID}}/post",
    "body": {}
  },
  {
    "id": "rent-ledger",
    "actor": "staff",
