          "modelState": "new",
          "modelStatus": "new",
          "assignRule": {
            "type": "roles",
            "roles": [
              "Support",
              "Owner"
            ],
            "mode": "any",
            "fallbackRoles": [
              "Owner"
            ]
          },
          "notificationTemplate": [
            "task-assignment",
            "task-assignment-sms"
          ],
          "escalations": [
            {
              "escalateAfter": 4,
              "units": "hours",
              "notificationTemplate": [
                "task-reminder",
                "task-reminder-sms"
              ]
            },
            {
